DATABASE_URL=postgresql+asyncpg://guldu:guldu@localhost:5432/guldu_bot
STORAGE_DIR=./storage
APP_ENV=development

# Production'da albatta o'zgartiring: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-me
