JWT_EXPIRE_MINUTES=480

# @BotFather'dan olingan Telegram bot tokeni
BOT_TOKEN=
ESCALATION_CHECK_INTERVAL_SECONDS=60
ESCALATION_BACKUP_AFTER_MINUTES=30
